Options -Indexes

<FilesMatch "^(error_log|.*\.log)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(PHPMailer|SMTP|Exception)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; font-src 'self'; frame-src https://calendly.com https://assets.calendly.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Ridondante con frame-ancestors della CSP, mantenuto per i browser
  # che non supportano la direttiva.
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

RewriteEngine On

# Redirect HTTP → HTTPS e non-www → www (un solo hop)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^lecasediluigi\.com$ [NC]
RewriteRule ^(.*)$ https://www.lecasediluigi.com/$1 [L,R=301]

# Legacy pages merged into SRC/consulenza.html
Redirect 301 /consulenza-personalizzata.html /SRC/consulenza.html
Redirect 301 /consulenza-fast.html /SRC/consulenza.html
Redirect 301 /SRC/consulenza-personalizzata.html /SRC/consulenza.html
Redirect 301 /SRC/consulenza-fast.html /SRC/consulenza.html
Redirect 301 /analisi-documentale.html /SRC/consulenza.html

# Immobili venduti o ritirati -> pagina elenco immobili.
# Target unico e volutamente generico: le schede singole si vendono a loro
# volta e diventerebbero anelli di catene di redirect da manutenere.
Redirect 301 /CASE/mini-appartamento-in-vendita-a-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/villino-in-vendita-a-scapezzano-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-vista-mare-ammobiliato-in-vendita-a-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/luminoso-trilocale-in-vendita-a-senigallia-le-saline.html /SRC/immobili.html
Redirect 301 /CASE/casa-bifamiliare-con-giardino-in-vendita-a-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/villa-a-schiera-in-vendita-a-casine-di-ostra.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-sul-mare-in-vendita-a-marzocca.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-semi-nuovo-in-vendita-a-barbara.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-indipendente-in-vendita-a-marina-di-montemarciano.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-centro-storico-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/favoloso-appartamento-al-ciarnin.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-sul-mare-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/grande-appartamento-a-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/villino-indipendente-senigallia.html /SRC/immobili.html
Redirect 301 /CASE/villa-in-vendita-in-Via-Capanna-Senigallia.html /SRC/immobili.html
Redirect 301 /CASE/appartamento-nuovo-con-giardino-in-vendita-a-senigallia-ponte-rosso.html /SRC/immobili.html

# NOTA: /CASE/stabilimento-balneare-rotonda-di-senigallia.html NON va
# reindirizzato. E' stata ricreata come pagina "immobile non più
# disponibile" con link agli immobili attuali: esiste già a quell'URL.

# URL rinominato (rimossa la ò accentata, problematica per alcuni
# tool SEO/indicizzazione). RedirectMatch sui byte percent-encoded:
# più affidabile di un Redirect con carattere UTF-8 letterale.
RedirectMatch 301 "^/CASE/la-casa-con-gli-obl(%C3%B2|ò)-in-vendita-a-senigallia\.html$" /CASE/la-casa-con-gli-oblo-in-vendita-a-senigallia.html
